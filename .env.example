# BankForge Environment Configuration

# JSON log verbosity (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=DEBUG

# Optional: path to append JSON log lines to a file
# LOG_FILE=./logs/app.log

# SQLite database file path
BANKFORGE_DB_PATH=./neobank.db

# Compliance gateway mode: http (default), inprocess, or offline
COMPLIANCE_GATEWAY=http

# Target URL for http compliance gateway
COMPLIANCE_SERVER_URL=http://127.0.0.1:8003/mcp

# Directory containing Markdown communication templates
COMMUNICATION_TEMPLATES_DIR=./communication_templates

# MCP transport mode (default is stdio)
MCP_TRANSPORT=stdio

# MCP host address (default is 127.0.0.1)
MCP_HOST=127.0.0.1
